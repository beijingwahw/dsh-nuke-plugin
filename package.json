{
  "name": "dsh-nuke-plugin",
  "version": "5.0.0",
  "description": "强力卸载 DSH 插件 — 策略分级 · 批量原子 · 指纹快照 · 健康检查 · 并发锁 · 报告导出",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beijingwahw/dsh-nuke-plugin.git"
  },
  "bugs": "https://github.com/beijingwahw/dsh-nuke-plugin/issues",
  "homepage": "https://github.com/beijingwahw/dsh-nuke-plugin#readme",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "nuke",
    "cleanup",
    "transaction"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "node --expose-internals --import tsx ./node_modules/@deepseek-ai/cordis/bin.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "latest",
    "@deepseek-ai/cordis-plugin-hmr": "^1.0.16",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/cordis-plugin-logger-console": "^1.0.1",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@types/node": "^24.13.3",
    "tsdown": "^0.12.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "yaml": "^2.4.0"
  }
}
